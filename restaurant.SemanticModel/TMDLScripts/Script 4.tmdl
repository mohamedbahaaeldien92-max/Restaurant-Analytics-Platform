createOrReplace

	ref table calcuation

		measure AOV = DIVIDE([Total Sales],[Orders])
			lineageTag: 8db3cd9b-d92d-4864-927a-57e61f9703cd

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure 'Average review' = AVERAGE(final_table_clean[rating])
			formatString: 0.0
			lineageTag: b3793416-9323-4811-bc93-b7f3b8bd6c16

		measure 'AVG Discount%' = AVERAGE(final_table_clean[discount])
			formatString: 0.00%;-0.00%;0.00%
			lineageTag: 8c9d7bd9-59c1-46b2-817a-aa9dbe1a99d0

		measure Customer = DISTINCTCOUNT(final_table_clean[customer_id])
			formatString: 0
			lineageTag: 5430a99e-1104-486d-b367-2dc765eb07a6

		measure 'Customer review' =
				
				VAR Rating = [Average review]
				VAR RoundedStars = ROUND(Rating, 0)
				RETURN
				REPT("⭐", RoundedStars) &
				REPT("☆", 5 - RoundedStars) &
				UNICHAR(10) &
				FORMAT(Rating, "0.00")
			lineageTag: 50fcb2dc-3e98-477d-98d4-bf7dce1ef824

		measure firstorder = YEAR(CALCULATE(MIN(final_table_clean[order_date])))
			formatString: 0
			lineageTag: 6fd11291-ec1a-4d73-b617-d36bfbe61def

		measure Items = ```
				
				VAR TopRank =
				    RANKX (
				        ALL ( 'final_table_clean'[item_name] ),
				        [Total Items],
				        ,
				        DESC,
				        DENSE
				    )
				
				VAR BottomRank =
				    RANKX (
				        ALL ( 'final_table_clean'[item_name] ),
				        [Total Items],
				        ,
				        ASC,
				        DENSE
				    )
				
				VAR SelectedType =
				    SELECTEDVALUE ( topbotton[Value] )
				
				VAR FinalRank =
				    IF ( SelectedType = "top", TopRank, BottomRank )
				
				RETURN
				    IF (
				        FinalRank <= SELECTEDVALUE ( ranking[ranking] ),
				        [Total Items],
				        BLANK ()
				    )
				
				```
			formatString: 0
			lineageTag: 9565bc61-d98a-42f2-9315-837a457a68fa

		measure 'MBA Data JSON' =
				
				
				VAR AllData =
				    SELECTCOLUMNS(
				        mba_rules,
				        "pa", TRIM ( mba_rules[Product_A] ),
				        "pb", TRIM ( mba_rules[Product_B] ),
				        "lf", mba_rules[lift],
				        "cf", mba_rules[confidence],
				        "st", TRIM ( mba_rules[Strength] )
				    )
				
				VAR MaxLift   = MAXX ( AllData, [lf] )
				VAR MinLift   = MINX ( AllData, [lf] )
				VAR AvgLift   = AVERAGEX ( AllData, [lf] )
				VAR TotalRows = COUNTROWS ( AllData )
				
				/* ── الإصلاح: TOPN يضمن صف واحد فقط ثم نقرأ pa و pb منه ── */
				VAR TopLift = MAXX ( AllData, [lf] )
				
				VAR TopRow =
				    TOPN (
				        1,
				        FILTER ( AllData, [lf] = TopLift ),
				        [pa], ASC
				    )
				
				VAR TopA    = MAXX ( TopRow, [pa] )
				VAR TopB    = MAXX ( TopRow, [pb] )
				VAR TopPair = TopA & " + " & TopB
				
				VAR TotalRowsFmt = FORMAT ( TotalRows, "0"   )
				VAR AvgLiftFmt   = FORMAT ( AvgLift,   "0.0" )
				VAR MaxLiftFmt   = FORMAT ( MaxLift,   "0.0" )
				VAR MinLiftFmt   = FORMAT ( MinLift,   "0.0" )
				
				VAR EdgesJSON =
				    CONCATENATEX (
				        AllData,
				        "{" &
				            """a""" & ":""" & [pa] & """," &
				            """b""" & ":""" & [pb] & """," &
				            """lift""" & ":" & FORMAT ( [lf], "0.00" ) & "," &
				            """conf""" & ":" & FORMAT ( [cf] * 100, "0.00" ) & "," &
				            """str""" & ":""" & [st] & """" &
				        "}",
				        ","
				    )
				
				RETURN
				"{" &
				    """rows"":"  & TotalRowsFmt & "," &
				    """avg"":"   & AvgLiftFmt   & "," &
				    """max"":"   & MaxLiftFmt   & "," &
				    """min"":"   & MinLiftFmt   & "," &
				    """top"":""" & TopPair      & """," &
				    """edges"":[" & EdgesJSON   & "]" &
				"}"
			lineageTag: caa0004a-607b-4705-9b39-c8f5b39062ca

		measure 'MBA Network Visual' =
				
				
