	measure Sales = ```
			
			VAR TopRank =
			    RANKX (
			        ALL ( 'final_table_clean'[item_name] ),
			        [Total Sales],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR BottomRank =
			    RANKX (
			        ALL ( 'final_table_clean'[item_name] ),
			        [Total Sales],
			        ,
			        ASC,
			        DENSE
			    )
			
			VAR SelectedType =
			    SELECTEDVALUE ( topbotton[Value] )
			
			VAR FinalRank =
			    IF ( SelectedType = "top", TopRank, BottomRank )
			
			RETURN
			    IF (
			        FinalRank <= SELECTEDVALUE ( ranking[ranking] ),
			        [Total Sales],
			        BLANK ()
			    )
			
			```
		lineageTag: 48b653c2-3637-4514-9491-f871e56d2d29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

