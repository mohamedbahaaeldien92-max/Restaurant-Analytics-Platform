			"<!DOCTYPE html><html><head><meta charset='UTF-8'><style>*{margin:0;padding:0;box-sizing:border-box}html,body{width:100%;height:100%;overflow:hidden}body{font-family:'Segoe UI',system-ui,Arial,sans-serif;background:#f0f4f8;color:#1a2634}#app{display:flex;flex-direction:column;height:100vh;padding:10px 12px;gap:8px}#kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;flex-shrink:0}.kpi{background:#fff;padding:9px 12px;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.07);border-left:3px solid #ddd}.kpi-label{font-size:9px;color:#6b7e8f;text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:2px}.kpi-val{font-size:20px;font-weight:700;color:#1a2634;line-height:1.1}.kpi-sub{font-size:9px;color:#6b7e8f;margin-top:1px}.kpi-text{font-size:11px;font-weight:700;line-height:1.3}#toolbar{display:flex;gap:7px;align-items:center;background:#fff;padding:7px 11px;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.07);flex-wrap:wrap;flex-shrink:0}#toolbar label{font-size:11px;color:#6b7e8f;font-weight:600;white-space:nowrap}#toolbar select,#toolbar button{padding:4px 10px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:11px;background:#fff;cursor:pointer;color:#1a2634;font-weight:500;font-family:inherit}#toolbar select:hover,#toolbar button:hover{border-color:#2563EB;background:#f0f6ff}#toolbar button:disabled{color:#aaa;background:#f8fafc;cursor:default}#tb-divider{width:1px;height:18px;background:#e2e8f0;flex-shrink:0}#clear-btn{border-color:#E63946!important;background:#fff5f5!important;color:#E63946!important;font-weight:600!important;display:none}#legend{display:flex;gap:10px;font-size:10px;color:#6b7e8f;align-items:center;margin-left:auto;flex-wrap:wrap}.leg{display:flex;align-items:center;gap:4px}.leg-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}#main{flex:1;display:flex;gap:8px;min-height:0}#canvas-wrap{flex:1;background:#fff;border-radius:10px;box-shadow:0 1px 4px rgba(0,0,0,.07);position:relative;overflow:hidden}canvas{position:absolute;inset:0;width:100%;height:100%}#hint{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);font-size:10px;color:#c8d3dd;pointer-events:none;white-space:nowrap}#focus-badge{position:absolute;top:10px;left:10px;background:#2563EB;color:#fff;font-size:10px;font-weight:700;padding:3px 9px;border-radius:12px;display:none;letter-spacing:.04em}#tip{position:absolute;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:11px 13px;font-size:11px;z-index:200;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,.13);width:210px;display:none}.tip-name{font-weight:700;font-size:13px;margin-bottom:7px;padding-bottom:5px;border-bottom:2px solid #eee}.tip-row{display:flex;justify-content:space-between;margin-bottom:3px}.tip-key{color:#6b7e8f;font-size:10px}.tip-val{font-weight:500;font-size:10px;color:#1a2634}.tip-val-hl{font-weight:700;font-size:11px}.tip-section{margin-top:7px;padding-top:5px;border-top:1px solid #e2e8f0;font-size:9px;color:#6b7e8f;font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin-bottom:3px}.tip-rec{display:flex;justify-content:space-between;align-items:center;margin-bottom:2px}.tip-rec-name{color:#1a2634;font-size:10px}.tip-rec-lift{font-weight:700;font-size:10px}#right-col{width:210px;flex-shrink:0;display:flex;flex-direction:column;gap:8px;min-height:0}#panel{width:100%;flex-shrink:0;display:none;flex-direction:column;gap:8px}#panel.visible{display:flex}#panel-header{border-radius:10px;padding:12px;color:#fff;box-shadow:0 2px 8px rgba(0,0,0,.15)}.ph-label{font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.8;margin-bottom:3px}.ph-name{font-size:14px;font-weight:700;margin-bottom:8px;line-height:1.3}.ph-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}.ph-stat{background:rgba(255,255,255,.18);border-radius:6px;padding:4px 6px}.ph-stat-label{font-size:8px;opacity:.75;margin-bottom:1px;font-weight:600;letter-spacing:.04em}.ph-stat-val{font-size:12px;font-weight:700}#panel-recs{background:#fff;border-radius:10px;padding:10px;box-shadow:0 1px 4px rgba(0,0,0,.07);overflow-y:auto;display:flex;flex-direction:column}.recs-title{font-size:9px;font-weight:700;color:#6b7e8f;letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}.rec-card{margin-bottom:6px;padding:7px 9px;border-radius:7px;background:#f0f4f8;border:1px solid transparent;position:relative}.rec-card.top{background:rgba(37,99,235,.05);border-color:rgba(37,99,235,.25)}.rec-best{position:absolute;top:4px;right:6px;font-size:8px;font-weight:700;color:#2563EB;letter-spacing:.04em;text-transform:uppercase}.rec-row1{display:flex;align-items:center;gap:5px;margin-bottom:3px}.rec-rank{font-size:9px;color:#6b7e8f;font-weight:600;width:13px}.rec-name{font-size:11px;font-weight:600;color:#1a2634;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rec-stats{display:flex;gap:6px;margin-bottom:4px}.rec-lift{font-size:10px;font-weight:700}.rec-conf{font-size:10px;color:#6b7e8f}.rec-bar-bg{height:3px;background:#e2e8f0;border-radius:2px;overflow:hidden}.rec-bar{height:100%;border-radius:2px}.rec-score{font-size:9px;color:#6b7e8f;margin-top:2px}#panel-guide{background:#fff;border-radius:10px;padding:8px 11px;box-shadow:0 1px 4px rgba(0,0,0,.07);display:flex;flex-direction:column;gap:0;overflow-y:auto;flex:1;min-height:0;justify-content:space-between}.guide-title{font-size:11px;font-weight:700;color:#6b7e8f;letter-spacing:.06em;text-transform:uppercase;margin-bottom:3px;flex-shrink:0}.guide-item{display:flex;gap:7px;align-items:center;padding:3px 0;border-bottom:1px solid #f0f4f8}.guide-item:last-of-type{border-bottom:none}.guide-icon{font-size:14px;flex-shrink:0;width:20px;text-align:center}.guide-text{font-size:12px;color:#1a2634;font-weight:500;line-height:1.15}.guide-lift-box{padding:6px 9px;background:#f0f4f8;border-radius:7px;margin-top:4px;flex-shrink:0}.guide-lift-title{font-size:11px;color:#1a2634;font-weight:700;margin-bottom:3px;letter-spacing:.04em}.guide-lift-item{font-size:11px;color:#1a2634;line-height:1.8}</style></head><body><div id='app'><div id='kpi-row'><div class='kpi' style='border-left-color:#E63946'><div class='kpi-label'>Association Rules</div><div class='kpi-val' id='k-rows'>-</div><div class='kpi-sub'>Visible pairs</div></div><div class='kpi' style='border-left-color:#F4A261'><div class='kpi-label'>Avg Lift</div><div class='kpi-val' id='k-avg'>-</div><div class='kpi-sub'>Baseline = 1.0x</div></div><div class='kpi' style='border-left-color:#E63946'><div class='kpi-label'>Max Lift</div><div class='kpi-val' id='k-max'>-</div><div class='kpi-sub'>Strongest pair</div></div><div class='kpi' style='border-left-color:#2A9D8F'><div class='kpi-label'>Top Products</div><div class='kpi-val' id='k-nodes'>-</div><div class='kpi-sub'>In network</div></div><div class='kpi' style='border-left-color:#2563EB'><div class='kpi-label'>Top Pairing</div><div class='kpi-text' id='k-top' style='color:#2563EB'>-</div></div></div><div id='toolbar'><label>Top N:</label><select id='topn' onchange='applyFilters()'><option value='999'>All</option><option value='20'>Top 20</option><option value='10' selected>Top 10</option><option value='5'>Top 5</option></select><span id='tb-divider'></span><label>Min Lift:</label><select id='filt' onchange='applyFilters()'><option value='0'>Any</option><option value='1.09' selected>1.09+</option><option value='1.10'>1.10+</option><option value='1.105'>1.105+</option></select><span style='width:1px;height:18px;background:#e2e8f0;flex-shrink:0'></span><label>Size by:</label><select id='szm' onchange='applyFilters()'><option value='deg'>Connections</option><option value='lift'>Lift</option></select><span style='width:1px;height:18px;background:#e2e8f0;flex-shrink:0'></span><button id='relayout-btn' onclick='reLayout()'>Re-layout</button><button onclick='fitView()'>Fit View</button><button id='clear-btn' onclick='clearSel()'>&times; Clear</button><div id='legend'><span class='leg'><span class='leg-dot' style='background:#2A9D8F'></span>Very Strong 1.105+</span><span class='leg'><span class='leg-dot' style='background:#2563EB'></span>Strong 1.09-1.105</span><span class='leg'><span class='leg-dot' style='background:#E63946'></span>Moderate &lt;1.09</span></div></div><div id='main'><div id='canvas-wrap'><canvas id='cv'></canvas><div id='focus-badge'>FOCUS MODE</div><div id='tip'><div class='tip-name' id='tip-name'></div><div class='tip-row'><span class='tip-key'>Max Lift</span><span class='tip-val-hl' id='tip-lift'></span></div><div class='tip-row'><span class='tip-key'>Avg Lift</span><span class='tip-val' id='tip-avg'></span></div><div class='tip-row'><span class='tip-key'>Connections</span><span class='tip-val' id='tip-deg'></span></div><div class='tip-row'><span class='tip-key'>Strength</span><span class='tip-val' id='tip-str'></span></div><div class='tip-section'>Top Bundles</div><div id='tip-recs'></div></div><div id='hint'>Scroll=zoom · Drag=pan · Click=explore</div></div><div id='right-col'><div id='panel'><div id='panel-header'><div class='ph-label'>Selected Product</div><div class='ph-name' id='ph-name'></div><div class='ph-grid'><div class='ph-stat'><div class='ph-stat-label'>Max Lift</div><div class='ph-stat-val' id='ph-lift'></div></div><div class='ph-stat'><div class='ph-stat-label'>Bundles</div><div class='ph-stat-val' id='ph-deg'></div></div><div class='ph-stat'><div class='ph-stat-label'>Avg Lift</div><div class='ph-stat-val' id='ph-avg'></div></div><div class='ph-stat'><div class='ph-stat-label'>Class</div><div class='ph-stat-val' id='ph-class'></div></div></div></div><div id='panel-recs'><div class='recs-title'>Cross-Sell Recommendations</div><div id='rec-list'></div></div></div><div id='panel-guide'><div class='guide-title'>How to Use</div><div class='guide-item'><span class='guide-icon'>🎯</span><span class='guide-text'>Use Top N to focus on strongest pairs</span></div><div class='guide-item'><span class='guide-icon'>🖱</span><span class='guide-text'>Hover node for details</span></div><div class='guide-item'><span class='guide-icon'>👆</span><span class='guide-text'>Click node for recommendations</span></div><div class='guide-item'><span class='guide-icon'>🔍</span><span class='guide-text'>Scroll to zoom</span></div><div class='guide-item'><span class='guide-icon'>✋</span><span class='guide-text'>Drag to pan</span></div><div class='guide-lift-box'><div class='guide-lift-title'>VISUAL ENCODING</div><div class='guide-lift-item'><span style='color:#2A9D8F'>●</span> <strong>&gt;1.105</strong> Very Strong<br><span style='color:#2563EB'>●</span> <strong>1.09-1.105</strong> Strong<br><span style='color:#E63946'>●</span> <strong>&lt;1.09</strong> Moderate<br><span style='color:#6b7e8f;font-size:10px'>Size = Connections · Line = Confidence</span></div></div></div></div></div></div><script>try{var DATA=JSON.parse('" & SafeD & "');document.getElementById('k-avg').textContent=DATA.avg+'x';document.getElementById('k-max').textContent=DATA.max+'x';document.getElementById('k-top').textContent=DATA.top;var RAW=DATA.edges.map(function(e){return{a:e.a,b:e.b,lift:parseFloat(e.lift),conf:parseFloat(e.conf),str:e.str};});function liftColor(l){return l>=1.105?'#2A9D8F':l>=1.09?'#2563EB':'#E63946';}function liftClass(l){return l>=1.105?'Very Strong':l>=1.09?'Strong':'Moderate';}function computeRadius(degree,maxLift,mode){if(mode==='lift'){var norm=(maxLift-1.08)/(1.11-1.08);return Math.max(30,Math.min(80,30+norm*50));}var ds=Math.min(degree/14,1);var ls=Math.min((maxLift-1.08)/0.03,1);return Math.round(36+(ds*0.6+ls*0.4)*54);}var NODES={},EDGES=[],ARR=[],SEL=null,NEIGHBOR_SET=[];var CAM={x:0,y:0,z:1},DRAGGING=null,PANNING=false,OX=0,OY=0;var ANIM_ID=null,SIM_TICK=0,SIM_MAX=320,DID_DRAG=false;function getRecs(node){var seen={};for(var i=0;i<node.neighborEdges.length;i++){var e=node.neighborEdges[i];var pid=e.s===node?e.t.id:e.s.id;var sc=e.lift*(e.conf/100);if(!seen[pid]||sc>seen[pid].score)seen[pid]={product:pid,lift:e.lift,conf:e.conf,score:sc,str:e.str};}var results=[];var ks=Object.keys(seen);for(var k=0;k<ks.length;k++)results.push(seen[ks[k]]);results.sort(function(a,b){return b.score-a.score;});return results.slice(0,5);}function applyFilters(){var minL=parseFloat(document.getElementById('filt').value)||0;var topN=parseInt(document.getElementById('topn').value)||999;var mode=document.getElementById('szm').value;var filt=RAW.filter(function(r){return r.lift>=minL;});var pairMap={};for(var i=0;i<filt.length;i++){var r=filt[i];var k=[r.a,r.b].sort().join('|||');if(!pairMap[k]||r.lift*(r.conf/100)>pairMap[k].lift*(pairMap[k].conf/100))pairMap[k]=r;}var deduped=[];var pks=Object.keys(pairMap);for(var p=0;p<pks.length;p++)deduped.push(pairMap[pks[p]]);deduped.sort(function(a,b){return b.lift-a.lift;});var nodeScore={};for(var i=0;i<deduped.length;i++){var r=deduped[i];nodeScore[r.a]=(nodeScore[r.a]||0)+r.lift;nodeScore[r.b]=(nodeScore[r.b]||0)+r.lift;}var topNodes=Object.keys(nodeScore).sort(function(a,b){return nodeScore[b]-nodeScore[a];}).slice(0,topN);var topSet={};for(var i=0;i<topNodes.length;i++)topSet[topNodes[i]]=1;var finalEdges=deduped.filter(function(r){return topSet[r.a]&&topSet[r.b];});document.getElementById('focus-badge').style.display=topN<999?'block':'none';buildGraph(finalEdges,mode);}function buildGraph(filteredEdges,mode){NODES={};EDGES=[];ARR=[];SEL=null;NEIGHBOR_SET=[];if(!filteredEdges.length)return;var raw={};for(var i=0;i<filteredEdges.length;i++){var r=filteredEdges[i];var keys=[r.a,r.b];for(var k=0;k<keys.length;k++){var id=keys[k];if(!raw[id])raw[id]={sum:0,max:0,cnt:0};raw[id].sum+=r.lift;if(r.lift>raw[id].max)raw[id].max=r.lift;raw[id].cnt++;}}var ids=Object.keys(raw);var n=ids.length;var maxConf=0;for(var i=0;i<filteredEdges.length;i++)if(filteredEdges[i].conf>maxConf)maxConf=filteredEdges[i].conf;for(var i=0;i<ids.length;i++){var id=ids[i];var angle=(i/n)*Math.PI*2;var r0=280+Math.random()*360;var maxL=raw[id].max;var deg=raw[id].cnt;var radius=computeRadius(deg,maxL,mode||'deg');NODES[id]={id:id,x:Math.cos(angle)*r0+(Math.random()-0.5)*50,y:Math.sin(angle)*r0+(Math.random()-0.5)*50,vx:0,vy:0,maxLift:maxL,avgLift:raw[id].sum/deg,degree:deg,radius:radius,color:liftColor(maxL),neighborEdges:[]};}for(var i=0;i<filteredEdges.length;i++){var r=filteredEdges[i];var lw=Math.max(1,Math.min(8,(r.conf/maxConf)*8));var e={lift:r.lift,conf:r.conf,str:r.str,s:NODES[r.a],t:NODES[r.b],score:r.lift*(r.conf/100),lineW:lw};EDGES.push(e);NODES[r.a].neighborEdges.push(e);NODES[r.b].neighborEdges.push(e);}ARR=Object.keys(NODES).map(function(k){return NODES[k];});document.getElementById('k-rows').textContent=filteredEdges.length;document.getElementById('k-nodes').textContent=ARR.length;updPanel();fitView();startSim();}function simStep(alpha){for(var i=0;i<ARR.length;i++){ARR[i].vx*=0.84;ARR[i].vy*=0.84;}for(var i=0;i<ARR.length;i++){for(var j=i+1;j<ARR.length;j++){var a=ARR[i],b=ARR[j];var dx=b.x-a.x,dy=b.y-a.y;var d2=dx*dx+dy*dy;if(d2===0){a.x+=(Math.random()-0.5)*2;continue;}var d=Math.sqrt(d2);var minD=a.radius+b.radius+70;var str=d<minD?8000/(d2+1):2500/(d2+1);var fx=(dx/d)*str,fy=(dy/d)*str;a.vx-=fx;a.vy-=fy;b.vx+=fx;b.vy+=fy;}}for(var i=0;i<EDGES.length;i++){var e=EDGES[i];var dx=e.t.x-e.s.x,dy=e.t.y-e.s.y;var d=Math.sqrt(dx*dx+dy*dy)||1;var liftNorm=(e.lift-1.08)/0.03;var rest=e.s.radius+e.t.radius+150+(1-liftNorm)*550;var f=((d-rest)/d)*0.055;e.s.vx+=dx*f;e.s.vy+=dy*f;e.t.vx-=dx*f;e.t.vy-=dy*f;}for(var i=0;i<ARR.length;i++){var n=ARR[i];n.vx-=n.x*0.012*alpha;n.vy-=n.y*0.012*alpha;n.x+=n.vx*alpha;n.y+=n.vy*alpha;}}var cv=document.getElementById('cv');var ctx=cv.getContext('2d');function isNb(node,n){for(var i=0;i<NEIGHBOR_SET.length;i++){if(NEIGHBOR_SET[i]===n)return true;}return false;}function draw(){ctx.clearRect(0,0,cv.width,cv.height);ctx.save();ctx.translate(CAM.x,CAM.y);ctx.scale(CAM.z,CAM.z);var W=cv.width/CAM.z,H=cv.height/CAM.z;var ox=-CAM.x/CAM.z,oy=-CAM.y/CAM.z;for(var i=0;i<EDGES.length;i++){var e=EDGES[i];var inV=Math.min(e.s.x,e.t.x)<ox+W+100&&Math.max(e.s.x,e.t.x)>ox-100&&Math.min(e.s.y,e.t.y)<oy+H+100&&Math.max(e.s.y,e.t.y)>oy-100;if(!inV)continue;var nb=SEL&&(e.s===SEL||e.t===SEL);var dm=SEL&&!nb;ctx.globalAlpha=dm?0.04:nb?0.92:SEL?0.18:0.35;ctx.strokeStyle=nb?liftColor(e.lift):'#c8d3dd';ctx.lineWidth=nb?e.lineW*1.4:e.lineW*0.7;ctx.beginPath();ctx.moveTo(e.s.x,e.s.y);ctx.lineTo(e.t.x,e.t.y);ctx.stroke();if(nb){var mx2=(e.s.x+e.t.x)/2,my2=(e.s.y+e.t.y)/2;ctx.globalAlpha=0.92;ctx.fillStyle=liftColor(e.lift);var bx=mx2-20,by=my2-9,br=4;ctx.beginPath();ctx.moveTo(bx+br,by);ctx.lineTo(bx+40-br,by);ctx.quadraticCurveTo(bx+40,by,bx+40,by+br);ctx.lineTo(bx+40,by+18-br);ctx.quadraticCurveTo(bx+40,by+18,bx+40-br,by+18);ctx.lineTo(bx+br,by+18);ctx.quadraticCurveTo(bx,by+18,bx,by+18-br);ctx.lineTo(bx,by+br);ctx.quadraticCurveTo(bx,by,bx+br,by);ctx.closePath();ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 9px Segoe UI,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(e.lift.toFixed(4)+'x',mx2,my2);}}ctx.shadowBlur=0;for(var i=0;i<ARR.length;i++){var n=ARR[i];if(n.x+n.radius<ox-20||n.x-n.radius>ox+W+20||n.y+n.radius<oy-20||n.y-n.radius>oy+H+20)continue;var isSel=n===SEL;var isNbN=SEL?isNb(SEL,n):false;var isDim=SEL&&!isSel&&!isNbN;ctx.globalAlpha=isDim?0.1:1;ctx.shadowBlur=isSel?18:isNbN?8:0;ctx.shadowColor=isSel?n.color:n.color+'88';ctx.beginPath();ctx.arc(n.x,n.y,n.radius,0,Math.PI*2);ctx.fillStyle=n.color;ctx.fill();if(isSel){ctx.shadowBlur=0;ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.stroke();ctx.strokeStyle=n.color;ctx.lineWidth=2;ctx.beginPath();ctx.arc(n.x,n.y,n.radius+5,0,Math.PI*2);ctx.stroke();}else{ctx.strokeStyle='rgba(255,255,255,.85)';ctx.lineWidth=1.8;ctx.stroke();}ctx.shadowBlur=0;if(!isDim){var words=n.id.split(/[\s\/]+/);var line1=words[0]||'';var line2=words.slice(1).join(' ')||'';var fs=Math.max(12,Math.min(17,Math.floor(n.radius*0.38)));ctx.fillStyle='#fff';ctx.font='bold '+fs+'px Segoe UI,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.globalAlpha=1;ctx.shadowColor='rgba(0,0,0,0.5)';ctx.shadowBlur=4;if(line2){ctx.fillText(line1,n.x,n.y-fs*0.7);ctx.fillText(line2,n.x,n.y+fs*0.4);}else{ctx.fillText(line1,n.x,n.y-2);}ctx.shadowBlur=0;ctx.font='bold '+Math.max(9,Math.min(12,Math.floor(n.radius*0.28)))+'px Segoe UI,sans-serif';ctx.fillStyle='rgba(255,255,255,0.75)';ctx.fillText(String(n.degree),n.x,n.y+n.radius*0.65);}}ctx.globalAlpha=1;ctx.restore();}function startSim(){if(ANIM_ID)cancelAnimationFrame(ANIM_ID);SIM_TICK=0;var btn=document.getElementById('relayout-btn');if(btn){btn.disabled=true;btn.textContent='Running...';}function step(){SIM_TICK++;var alpha=Math.max(0.015,1-SIM_TICK/SIM_MAX);simStep(alpha);draw();if(SIM_TICK<SIM_MAX){ANIM_ID=requestAnimationFrame(step);}else{ANIM_ID=null;if(btn){btn.disabled=false;btn.textContent='Re-layout';}}}step();}function worldPos(ex,ey){return{x:(ex-CAM.x)/CAM.z,y:(ey-CAM.y)/CAM.z};}function fitView(){if(!ARR.length){CAM={x:cv.width/2,y:cv.height/2,z:1};draw();return;}var minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;for(var i=0;i<ARR.length;i++){var n=ARR[i];minX=Math.min(minX,n.x-n.radius-20);maxX=Math.max(maxX,n.x+n.radius+20);minY=Math.min(minY,n.y-n.radius-20);maxY=Math.max(maxY,n.y+n.radius+20);}var W=cv.width,H=cv.height;var scaleX=W/(maxX-minX),scaleY=H/(maxY-minY);var z=Math.min(scaleX,scaleY,1.2)*0.88;CAM={x:W/2-((minX+maxX)/2)*z,y:H/2-((minY+maxY)/2)*z,z:z};draw();}function resize(){var p=cv.parentElement;cv.width=p?p.clientWidth:900;cv.height=p?p.clientHeight:540;fitView();}function hitTest(ex,ey){var w=worldPos(ex,ey);for(var i=ARR.length-1;i>=0;i--){var n=ARR[i];if(Math.sqrt((n.x-w.x)*(n.x-w.x)+(n.y-w.y)*(n.y-w.y))<n.radius+5)return n;}return null;}function updPanel(){var panel=document.getElementById('panel');var guide=document.getElementById('panel-guide');var clearBtn=document.getElementById('clear-btn');if(SEL){panel.classList.add('visible');guide.style.display='none';clearBtn.style.display='';var shortName=SEL.id.length>13?SEL.id.slice(0,12)+'...':SEL.id;clearBtn.textContent='\u00d7 '+shortName;document.getElementById('panel-header').style.background=SEL.color;document.getElementById('ph-name').textContent=SEL.id;document.getElementById('ph-lift').textContent=SEL.maxLift.toFixed(4)+'x';document.getElementById('ph-deg').textContent=String(SEL.degree);document.getElementById('ph-avg').textContent=SEL.avgLift.toFixed(4)+'x';document.getElementById('ph-class').textContent=liftClass(SEL.maxLift);var recs=getRecs(SEL);var list=document.getElementById('rec-list');list.innerHTML='';for(var i=0;i<recs.length;i++){var r=recs[i];var bar=Math.min(100,(r.score/1.5)*100);var c=liftColor(r.lift);var nm=r.product.length>16?r.product.slice(0,14)+'...':r.product;var isTop=i===0;var div=document.createElement('div');div.className='rec-card'+(isTop?' top':'');div.innerHTML=(isTop?'<div class='+chr(39)+'rec-best'+chr(39)+'>BEST</div>':'')+'<div class='+chr(39)+'rec-row1'+chr(39)+'><span class='+chr(39)+'rec-rank'+chr(39)+'>#'+(i+1)+'</span><span class='+chr(39)+'rec-name'+chr(39)+' title='+chr(39)+r.product+chr(39)+'>'+nm+'</span></div><div class='+chr(39)+'rec-stats'+chr(39)+'><span class='+chr(39)+'rec-lift'+chr(39)+' style='+chr(39)+'color:'+c+chr(39)+'>'+r.lift.toFixed(4)+'x</span><span class='+chr(39)+'rec-conf'+chr(39)+'>'+r.conf.toFixed(1)+'% conf</span></div><div class='+chr(39)+'rec-bar-bg'+chr(39)+'><div class='+chr(39)+'rec-bar'+chr(39)+' style='+chr(39)+'width:'+bar+'%;background:'+c+chr(39)+'></div></div><div class='+chr(39)+'rec-score'+chr(39)+'>Score: '+r.score.toFixed(4)+'</div>';list.appendChild(div);}}else{panel.classList.remove('visible');guide.style.display='';clearBtn.style.display='none';}}function clearSel(){SEL=null;NEIGHBOR_SET=[];updPanel();draw();}function chr(n){return String.fromCharCode(n);}var tip=document.getElementById('tip');var lastTipNode=null;function showTip(node,ex,ey){if(node===lastTipNode){posTip(ex,ey);return;}lastTipNode=node;var nameEl=document.getElementById('tip-name');nameEl.textContent=node.id;nameEl.style.color=node.color;nameEl.style.borderBottomColor=node.color+'33';var liftEl=document.getElementById('tip-lift');liftEl.textContent=node.maxLift.toFixed(4)+'x';liftEl.style.color=node.color;document.getElementById('tip-avg').textContent=node.avgLift.toFixed(4)+'x';document.getElementById('tip-deg').textContent=node.degree+' products';document.getElementById('tip-str').textContent=liftClass(node.maxLift);var recs=getRecs(node).slice(0,3);var recsEl=document.getElementById('tip-recs');recsEl.innerHTML='';for(var i=0;i<recs.length;i++){var r=recs[i];var nm=r.product.length>14?r.product.slice(0,12)+'...':r.product;recsEl.innerHTML+='<div class='+chr(39)+'tip-rec'+chr(39)+'><span class='+chr(39)+'tip-rec-name'+chr(39)+'><span style='+chr(39)+'color:#6b7e8f'+chr(39)+'>'+(i+1)+'.</span> '+nm+'</span><span class='+chr(39)+'tip-rec-lift'+chr(39)+' style='+chr(39)+'color:'+liftColor(r.lift)+chr(39)+'>'+r.lift.toFixed(4)+'x</span></div>';}tip.style.display='block';posTip(ex,ey);}function hideTip(){tip.style.display='none';lastTipNode=null;}function posTip(ex,ey){var cw=cv.parentElement.clientWidth,ch=cv.parentElement.clientHeight;var tx=ex+14,ty=ey-10;if(tx+220>cw)tx=ex-225;if(ty+240>ch)ty=ch-245;if(ty<4)ty=4;tip.style.left=tx+'px';tip.style.top=ty+'px';}function reLayout(){applyFilters();}cv.addEventListener('mousedown',function(e){DID_DRAG=false;var n=hitTest(e.offsetX,e.offsetY);if(n){DRAGGING=n;}else{PANNING=true;}OX=e.offsetX;OY=e.offsetY;});cv.addEventListener('mousemove',function(e){var dx=e.offsetX-OX,dy=e.offsetY-OY;if(Math.sqrt(dx*dx+dy*dy)>3)DID_DRAG=true;if(DRAGGING){var w=worldPos(e.offsetX,e.offsetY);DRAGGING.x=w.x;DRAGGING.y=w.y;DRAGGING.vx=0;DRAGGING.vy=0;draw();return;}if(PANNING){CAM.x+=dx;CAM.y+=dy;OX=e.offsetX;OY=e.offsetY;draw();return;}var n=hitTest(e.offsetX,e.offsetY);if(n){showTip(n,e.offsetX,e.offsetY);cv.style.cursor='pointer';}else{hideTip();cv.style.cursor='default';}}); cv.addEventListener('mouseup',function(){DRAGGING=null;PANNING=false;});cv.addEventListener('mouseleave',function(){hideTip();DRAGGING=null;PANNING=false;});cv.addEventListener('click',function(e){if(DID_DRAG)return;var n=hitTest(e.offsetX,e.offsetY);if(n&&n!==SEL){SEL=n;NEIGHBOR_SET=[];for(var i=0;i<n.neighborEdges.length;i++){var ed=n.neighborEdges[i];NEIGHBOR_SET.push(ed.s===n?ed.t:ed.s);}}else{SEL=null;NEIGHBOR_SET=[];}updPanel();draw();});cv.addEventListener('wheel',function(e){e.preventDefault();var zf=e.deltaY>0?0.9:1.11;CAM.x=e.offsetX-(e.offsetX-CAM.x)*zf;CAM.y=e.offsetY-(e.offsetY-CAM.y)*zf;CAM.z=Math.max(0.1,Math.min(8,CAM.z*zf));draw();},{passive:false});window.addEventListener('resize',function(){resize();draw();});applyFilters();requestAnimationFrame(function(){resize();});}catch(err){document.body.innerHTML='<div style=padding:20px;color:#E63946;font-family:sans-serif><strong>Error:</strong> '+err.message+'</div>';console.error(err);}
			</script></body></html>"
