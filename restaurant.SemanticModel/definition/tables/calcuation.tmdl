table calcuation
	lineageTag: 948bafea-7e82-42ab-b783-1fdad6831d5e

	measure 'Total Sales' = SUM(final_table_clean[total_amount])
		lineageTag: b1936188-8c6b-4bf3-9d61-1aa7064d1999

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Orders = COUNT(final_table_clean[order_id])
		formatString: 0
		lineageTag: 62746132-b2fd-410c-94a4-d6b10ee87f90

	measure 'Number of branches' = DISTINCTCOUNT(final_table_clean[branch])
		formatString: 0
		lineageTag: 6c5faf76-4e39-47d7-975e-b3edf8aad89e

	measure 'Average review' = AVERAGE(final_table_clean[rating])
		formatString: 0.0
		lineageTag: b3793416-9323-4811-bc93-b7f3b8bd6c16

	measure 'Customer review' =
			
			VAR Rating = [Average review]
			VAR RoundedStars = ROUND(Rating, 0)
			RETURN
			REPT("⭐", RoundedStars) &
			REPT("☆", 5 - RoundedStars) &
			UNICHAR(10) &
			FORMAT(Rating, "0.00")
		lineageTag: 50fcb2dc-3e98-477d-98d4-bf7dce1ef824

	measure Customer = DISTINCTCOUNT(final_table_clean[customer_id])
		formatString: 0
		lineageTag: 5430a99e-1104-486d-b367-2dc765eb07a6

	measure 'Total Items' = SUM(final_table_clean[quantity])
		formatString: 0
		lineageTag: 72370eda-3ce4-44c1-bdb6-b80d69741d2c

	measure AOV = DIVIDE([Total Sales],[Orders])
		lineageTag: 8db3cd9b-d92d-4864-927a-57e61f9703cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure RepeatCustomers = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(final_table_clean[customer_id]),
			        FILTER(
			            VALUES(final_table_clean[customer_id]),
			            CALCULATE(COUNTROWS(final_table_clean)) > 1
			        )
			    )
			```
		formatString: 0
		lineageTag: 95a19eec-fb64-48c5-8260-f5660fbc8bae

	measure firstorder = YEAR(CALCULATE(MIN(final_table_clean[order_date])))
		formatString: 0
		lineageTag: 6fd11291-ec1a-4d73-b617-d36bfbe61def

	measure 'AVG Discount%' = AVERAGE(final_table_clean[discount])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8c9d7bd9-59c1-46b2-817a-aa9dbe1a99d0

	measure 'MBA Data JSON' =
			
			
			VAR AllData =
			    SELECTCOLUMNS(
			        mba_rules,
			        "pa", TRIM ( mba_rules[Product_A] ),
			        "pb", TRIM ( mba_rules[Product_B] ),
			        "lf", mba_rules[lift],
			        "cf", mba_rules[confidence],
			        "st", TRIM ( mba_rules[Strength] )
			    )
			
			VAR MaxLift   = MAXX ( AllData, [lf] )
			VAR MinLift   = MINX ( AllData, [lf] )
			VAR AvgLift   = AVERAGEX ( AllData, [lf] )
			VAR TotalRows = COUNTROWS ( AllData )
			
			/* ── الإصلاح: TOPN يضمن صف واحد فقط ثم نقرأ pa و pb منه ── */
			VAR TopLift = MAXX ( AllData, [lf] )
			
			VAR TopRow =
			    TOPN (
			        1,
			        FILTER ( AllData, [lf] = TopLift ),
			        [pa], ASC
			    )
			
			VAR TopA    = MAXX ( TopRow, [pa] )
			VAR TopB    = MAXX ( TopRow, [pb] )
			VAR TopPair = TopA & " + " & TopB
			
			VAR TotalRowsFmt = FORMAT ( TotalRows, "0"   )
			VAR AvgLiftFmt   = FORMAT ( AvgLift,   "0.0" )
			VAR MaxLiftFmt   = FORMAT ( MaxLift,   "0.0" )
			VAR MinLiftFmt   = FORMAT ( MinLift,   "0.0" )
			
			VAR EdgesJSON =
			    CONCATENATEX (
			        AllData,
			        "{" &
			            """a""" & ":""" & [pa] & """," &
			            """b""" & ":""" & [pb] & """," &
			            """lift""" & ":" & FORMAT ( [lf], "0.00" ) & "," &
			            """conf""" & ":" & FORMAT ( [cf] * 100, "0.00" ) & "," &
			            """str""" & ":""" & [st] & """" &
			        "}",
			        ","
			    )
			
			RETURN
			"{" &
			    """rows"":"  & TotalRowsFmt & "," &
			    """avg"":"   & AvgLiftFmt   & "," &
			    """max"":"   & MaxLiftFmt   & "," &
			    """min"":"   & MinLiftFmt   & "," &
			    """top"":""" & TopPair      & """," &
			    """edges"":[" & EdgesJSON   & "]" &
			"}"
		lineageTag: caa0004a-607b-4705-9b39-c8f5b39062ca

	measure 'MBA Network Visual' =
			
			
			VAR D     = "{""avg"": 1.0971, ""max"": 1.1091, ""top"": ""شيش طاووق + محشي باذنجان"", ""edges"": [{""a"": ""بابا غنوج"", ""b"": ""سلطة بلدي"", ""lift"": 1.0974, ""conf"": 21.05, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""شاي"", ""lift"": 1.1037, ""conf"": 11.23, ""str"": ""Very Strong""}, {""a"": ""بابا غنوج"", ""b"": ""شيش طاووق"", ""lift"": 1.1045, ""conf"": 21.21, ""str"": ""Very Strong""}, {""a"": ""بابا غنوج"", ""b"": ""طاجن بامية"", ""lift"": 1.0994, ""conf"": 29.89, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""طاجن فراخ"", ""lift"": 1.0962, ""conf"": 37.55, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""طاجن ملوخية"", ""lift"": 1.0995, ""conf"": 29.92, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""طحينة"", ""lift"": 1.0957, ""conf"": 44.42, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""عصير قصب"", ""lift"": 1.0973, ""conf"": 29.85, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""عصير مانجو"", ""lift"": 1.0923, ""conf"": 50.39, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""كباب"", ""lift"": 1.0924, ""conf"": 44.23, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""كفتة"", ""lift"": 1.0992, ""conf"": 29.96, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""محشي باذنجان"", ""lift"": 1.1041, ""conf"": 21.27, ""str"": ""Very Strong""}, {""a"": ""بابا غنوج"", ""b"": ""محشي كوسة"", ""lift"": 1.0973, ""conf"": 37.59, ""str"": ""Strong""}, {""a"": ""بابا غنوج"", ""b"": ""محشي ورق عنب"", ""lift"": 1.0967, ""conf"": 37.57, ""str"": ""Strong""}, {""a"": ""سلطة بلدي"", ""b"": ""بابا غنوج"", ""lift"": 1.0974, ""conf"": 29.84, ""str"": ""Strong""}, {""a"": ""سلطة بلدي"", ""b"": ""شاي"", ""lift"": 1.1023, ""conf"": 11.22, ""str"": ""Very Strong""}, {""a"": ""سلطة بلدي"", ""b"": ""شيش طاووق"", ""lift"": 1.109, ""conf"": 21.29, ""str"": ""Very Strong""}, {""a"": ""سلطة بلدي"", ""b"": ""طاجن بامية"", ""lift"": 1.1034, ""conf"": 30.0, ""str"": ""Very Strong""}, {""a"": ""سلطة بلدي"", ""b"": ""طاجن فراخ"", ""lif