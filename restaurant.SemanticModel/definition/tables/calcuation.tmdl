	measure ReviewsDashboard =
			
			
			/* ══ SECTION 0 — GUARD ══════════════════════════════════ */
			VAR _HasData = COUNTROWS(final_table_clean) > 0
			
			/* ══ SECTION 1 — GLOBAL METRICS ════════════════════════ */
			VAR _TR  = COUNTROWS(final_table_clean)
			VAR _Rev = SUM(final_table_clean[total_amount])
			VAR _Qty = SUM(final_table_clean[quantity])
			VAR _AvgR =
			    IF(_TR = 0, 0, DIVIDE(SUM(final_table_clean[rating]), _TR, 0))
			VAR _WtdR =
			    DIVIDE(
			        SUMX(final_table_clean, final_table_clean[rating] * final_table_clean[quantity]),
			        _Qty, 0)
			VAR _C5 = CALCULATE(COUNTROWS(final_table_clean), final_table_clean[rating] = 5)
			VAR _C4 = CALCULATE(COUNTROWS(final_table_clean), final_table_clean[rating] = 4)
			VAR _C3 = CALCULATE(COUNTROWS(final_table_clean), final_table_clean[rating] = 3)
			VAR _C2 = CALCULATE(COUNTROWS(final_table_clean), final_table_clean[rating] = 2)
			VAR _C1 = CALCULATE(COUNTROWS(final_table_clean), final_table_clean[rating] = 1)
			VAR _PosN = _C5 + _C4
			VAR _NeuN = _C3
			VAR _NegN = _C2 + _C1
			VAR _PosP = DIVIDE(_PosN, _TR, 0)
			VAR _NeuP = DIVIDE(_NeuN, _TR, 0)
			VAR _NegP = DIVIDE(_NegN, _TR, 0)
			VAR _CSI  = ROUND((_PosP - _NegP + 1) / 2 * 100, 1)
			
			/* ══ SECTION 2 — CHANNEL ANALYTICS ═════════════════════ */
			VAR _DineR = CALCULATE(SUM(final_table_clean[rating]),   KEEPFILTERS(final_table_clean[order_type] = "Dine-in"))
			VAR _DineN = CALCULATE(COUNTROWS(final_table_clean),     KEEPFILTERS(final_table_clean[order_type] = "Dine-in"))
			VAR _TakeR = CALCULATE(SUM(final_table_clean[rating]),   KEEPFILTERS(final_table_clean[order_type] = "Takeaway"))
			VAR _TakeN = CALCULATE(COUNTROWS(final_table_clean),     KEEPFILTERS(final_table_clean[order_type] = "Takeaway"))
			VAR _DelR  = CALCULATE(SUM(final_table_clean[rating]),   KEEPFILTERS(final_table_clean[order_type] = "Delivery"))
			VAR _DelN  = CALCULATE(COUNTROWS(final_table_clean),     KEEPFILTERS(final_table_clean[order_type] = "Delivery"))
			VAR _DineA = DIVIDE(_DineR, _DineN, 0)
			VAR _TakeA = DIVIDE(_TakeR, _TakeN, 0)
			VAR _DelA  = DIVIDE(_DelR,  _DelN,  0)
			VAR _Gap   = ROUND(_DineA - _DelA, 2)
			VAR _GapA  = ABS(_Gap)
			
			/* ══ SECTION 3 — ACTIVE FILTER LABELS ══════════════════ */
			VAR _TotalCats     = CALCULATE(COUNTROWS(VALUES(final_table_clean[category])),       ALL(final_table_clean[category]))
			VAR _TotalBranches = CALCULATE(COUNTROWS(VALUES(final_table_clean[branch])),         ALL(final_table_clean[branch]))
			VAR _TotalPayments = CALCULATE(COUNTROWS(VALUES(final_table_clean[payment_method])), ALL(final_table_clean[payment_method]))
			VAR _SelCats       = COUNTROWS(VALUES(final_table_clean[category]))
			VAR _SelBranches   = COUNTROWS(VALUES(final_table_clean[branch]))
			VAR _SelPayments   = COUNTROWS(VALUES(final_table_clean[payment_method]))
			VAR _LblCat  = IF(_SelCats     = _TotalCats,     "All",
			                  CONCATENATEX(VALUES(final_table_clean[category]),     final_table_clean[category],     ", "))
			VAR _LblBrch = IF(_SelBranches = _TotalBranches, "All",
			                  CONCATENATEX(VALUES(final_table_clean[branch]),       final_table_clean[branch],       ", "))
			VAR _LblPay  = IF(_SelPayments = _TotalPayments, "All",
			                  CONCATENATEX(VALUES(final_table_clean[payment_method]),final_table_clean[payment_method],", "))
			VAR _ChipCat  = IF(_SelCats     < _TotalCats,     "on", "off")
			VAR _ChipBrch = IF(_SelBranches < _TotalBranches, "on", "off")
			VAR _ChipPay  = IF(_SelPayments < _TotalPayments, "on", "off")
			
			/* ══ SECTION 4 — ITEM TABLE ═════════════════════════════ */
			VAR _IBase =
			    ADDCOLUMNS(
			        SUMMARIZE(final_table_clean, final_table_clean[item_name]),
			        "@N",    CALCULATE(COUNTROWS(final_table_clean)),
			        "@SumR", CALCULATE(SUM(final_table_clean[rating])),
			        "@SumQ", CALCULATE(SUM(final_table_clean[quantity])),
			        "@SumW", CALCULATE(SUMX(final_table_clean, final_table_clean[rating] * final_table_clean[quantity])),
			        "@Rev",  CALCULATE(SUM(final_table_clean[total_amount]))
			    )
			VAR _IFull =
			    ADDCOLUMNS(_IBase,
			        "@WR",  DIVIDE([@SumW], [@SumQ], 0),
			        "@Qty", [@SumQ]
			    )
			VAR _IF      = FILTER(_IFull, [@N] > 0 && [@Rev] > 0)
			VAR _IC      = COUNTROWS(_IF)
			VAR _MaxRev  = MAXX(_IF, [@Rev])
			VAR _AvgQtyI = AVERAGEX(_IF, [@Qty])
			VAR _T3Rev   = TOPN(3, _IF, [@Rev], DESC)
			VAR _T5Rev   = TOPN(5, _IF, [@Rev], DESC)
			VAR _RiskT   = TOPN(1, _T3Rev, [@WR], ASC)
			VAR _StarT   = TOPN(1, _T5Rev, [@WR], DESC)
			VAR _RiskNm  = IFERROR(MAXX(_RiskT, [item_name]), "N/A")
			VAR _StarNm  = IFERROR(MAXX(_StarT, [item_name]), "N/A")
			VAR _OppT    =
			    TOPN(1,
			         FILTER(_IF,
			                [@WR]  >= 2.5 && [@WR] < 4.2 &&
			                [@Qty] >= _AvgQtyI &&
			                [item_name] <> _RiskNm &&
			                [item_name] <> _StarNm),
			         [@Qty], DESC)
			VAR _RiskR   = IFERROR(MAXX(_RiskT, [@WR]),  0)
			VAR _StarR   = IFERROR(MAXX(_StarT, [@WR]),  0)
			VAR _OppNm   = IFERROR(MAXX(_OppT,  [item_name]), "N/A")
			VAR _OppR    = IFERROR(MAXX(_OppT,  [@WR]),  0)
			VAR _OppQ    = IFERROR(MAXX(_OppT,  [@Qty]), 0)
			VAR _RiskRv  = IFERROR(MAXX(_RiskT, [@Rev]), 0)
			VAR _StarRv  = IFERROR(MAXX(_StarT, [@Rev]), 0)
			
			/* ══ SECTION 5 — TREND ══════════════════════════════════ */
			VAR _TRaw =
			    ADDCOLUMNS(
			        SUMMARIZE('calendar', 'calendar'[Year], 'calendar'[month number], 'calendar'[MonthYear]),
			        "@S", 'calendar'[Year] * 100 + 'calendar'[month number],
			        "@R",
			            CALCULATE(
			                DIVIDE(SUM(final_table_clean[rating]), COUNTROWS(final_table_clean), BLANK()),
			                TREATAS(SUMMARIZE('calendar', 'calendar'[Date]), final_table_clean[order_date])
			            )
			    )
			VAR _TF      = FILTER(_TRaw, NOT ISBLANK([@R]) && [@R] > 0)
			VAR _TD      = TOPN(6, _TF, [@S], DESC)
			VAR _TMax    = MAXX(_TD, [@R])
			VAR _TMin    = MINX(_TD, [@R])
			VAR _TRng    = IF(_TMax = _TMin, 0.1, _TMax - _TMin)
			VAR _LS      = MAXX(_TD, [@S])
			VAR _PS      = MAXX(FILTER(_TD, [@S] < _LS), [@S])
			VAR _LR      = MAXX(FILTER(_TD, [@S] = _LS), [@R])
			VAR _PR      = MAXX(FILTER(_TD, [@S] = _PS), [@R])
			VAR _TDelta  = IF(ISBLANK(_PR), 0, ROUND(_LR - _PR, 2))
			VAR _TArr    = IF(_TDelta >  0.01, "▲", IF(_TDelta < -0.01, "▼", "►"))
			VAR _TArrC   = IF(_TDelta >  0.01, "#10B981", IF(_TDelta < -0.01, "#EF4444", "#94A3B8"))
			VAR _TDeltaFmt = FORMAT(ABS(_TDelta), "0.00")
			
			/* ══ SECTION 6 — FORMAT STRINGS ════════════════════════ */
			VAR _fAvg   = FORMAT(_AvgR,  "0.00")
			VAR _fWtd   = FORMAT(_WtdR,  "0.00")
			VAR _fTR    = FORMAT(_TR,    "#,##0")
			VAR _fCSI   = FORMAT(_CSI,   "0.0")
			VAR _fPos   = FORMAT(ROUND(_PosP * 100, 1), "0.0")
			VAR _fNeg   = FORMAT(ROUND(_NegP * 100, 1), "0.0")
			VAR _fNeu   = FORMAT(ROUND(_NeuP * 100, 1), "0.0")
			VAR _fGap   = FORMAT(_GapA,  "0.00")
			VAR _fDine  = FORMAT(_DineA, "0.00")
			VAR _fTake  = FORMAT(_TakeA, "0.00")
			VAR _fDel   = FORMAT(_DelA,  "0.00")
			VAR _fDineW = FORMAT(ROUND(DIVIDE(_DineA, 5) * 100, 0), "0")
			VAR _fTakeW = FORMAT(ROUND(DIVIDE(_TakeA, 5) * 100, 0), "0")
			VAR _fDelW  = FORMAT(ROUND(DIVIDE(_DelA,  5) * 100, 0), "0")
			VAR _fPosB  = FORMAT(ROUND(_PosP * 100, 0), "0")
			VAR _fNeuB  = FORMAT(ROUND(_NeuP * 100, 0), "0")
			VAR _fNegB  = FORMAT(ROUND(_NegP * 100, 0), "0")
			VAR _fW5    = FORMAT(ROUND(DIVIDE(_C5, _TR, 0) * 100, 0), "0")
			VAR _fW4    = FORMAT(ROUND(DIVIDE(_C4, _TR, 0) * 100, 0), "0")
			VAR _fW3    = FORMAT(ROUND(DIVIDE(_C3, _TR, 0) * 100, 0), "0")
			VAR _fW2    = FORMAT(ROUND(DIVIDE(_C2, _TR, 0) * 100, 0), "0")
			VAR _fW1    = FORMAT(ROUND(DIVIDE(_C1, _TR, 0) * 100, 0), "0")
			VAR _fRR    = FORMAT(_RiskR, "0.00")
			VAR _fSR    = FORMAT(_StarR, "0.00")
			VAR _fOR    = FORMAT(_OppR,  "0.00")
			VAR _fRRv   = FORMAT(_RiskRv,"#,##0")
			VAR _fSRv   = FORMAT(_StarRv,"#,##0")
			
			/* ══ SECTION 7 — SEMANTIC COLORS ════════════════════════ */
			VAR _cAvg  = IF(_AvgR  >= 4.2, "#10B981", IF(_AvgR  >= 3.5, "#F59E0B", "#EF4444"))
			VAR _cWtd  = IF(_WtdR  >= 4.2, "#10B981", IF(_WtdR  >= 3.5, "#F59E0B", "#EF4444"))
			VAR _cCSI  = IF(_CSI   >= 75,  "#10B981", IF(_CSI   >= 55,  "#F59E0B", "#EF4444"))
			VAR _cGap  = IF(_GapA  <= 0.3, "#10B981", IF(_GapA  <  0.6, "#F59E0B", "#EF4444"))
			VAR _cDine = IF(_DineA >= 4.2, "#10B981", IF(_DineA >= 3.5, "#F59E0B", "#EF4444"))
			VAR _cTake = IF(_TakeA >= 4.2, "#10B981", IF(_TakeA >= 3.5, "#F59E0B", "#EF4444"))
			VAR _cDel  = IF(_DelA  >= 4.2, "#10B981", IF(_DelA  >= 3.5, "#F59E0B", "#EF4444"))
			VAR _kAvg  = IF(_AvgR  >= 4.2, "g", IF(_AvgR  >= 3.5, "a", "r"))
			VAR _kPos  = IF(_PosP  >= 0.7, "g", IF(_PosP  >= 0.5, "a", "r"))
			VAR _kNeg  = IF(_NegP  <= 0.08,"g", IF(_NegP  <= 0.15,"a", "r"))
			VAR _kCSI  = IF(_CSI   >= 75,  "g", IF(_CSI   >= 55,  "a", "r"))
			VAR _S1    = IF(_AvgR >= 1,   "#F59E0B", "#E2E8F0")
			VAR _S2    = IF(_AvgR >= 2,   "#F59E0B", "#E2E8F0")
			VAR _S3    = IF(_AvgR >= 3,   "#F59E0B", "#E2E8F0")
			VAR _S4    = IF(_AvgR >= 4,   "#F59E0B", "#E2E8F0")
			VAR _S5    = IF(_AvgR >= 4.5, "#F59E0B", "#E2E8F0")
			VAR _gBg   = IF(_GapA <= 0.3, "#ECFDF5", IF(_GapA < 0.6, "#FFFBEB", "#FEF2F2"))
			VAR _gTx   = IF(_GapA <= 0.3, "#065F46", IF(_GapA < 0.6, "#B45309", "#991B1B"))
			VAR _gMsg  = IF(_GapA <= 0.3, "✓ Channels aligned",
			             IF(_GapA <  0.6, "⚠ Moderate gap — monitor",
			                               "✕ Critical gap — urgent action"))
			VAR _gDir  = IF(_Gap > 0, "below", IF(_Gap < 0, "above", "equal to"))
			VAR _rec   =
			    IF(_GapA > 0.5,
			       "Delivery is " & _fGap & " pts below Dine-in. Focus on packaging and ETA accuracy. Deploy a targeted exit survey this week.",
			    IF(_CSI < 55,
			       "CSI at " & _fCSI & "/100 is below threshold. Address " & _RiskNm & " first — highest revenue with lowest rating equals maximum brand risk.",
			    IF(_NegP > 0.15,
			       "Negative reviews at " & _fNeg & "% exceed the 15% alert level. Root-cause the 1-2 star orders this week.",
			       "Stable at CSI " & _fCSI & ". Scale " & _StarNm & " in marketing. Refine " & _OppNm & " quality for the highest CSI leverage.")))
			
			/* ══ SECTION 8 — HTML FRAGMENTS ════════════════════════ */
			
			/* Filter status bar */
			VAR _hFBar =
			    "<div class='fbar'>"
			    & "<span class='fb-lbl'>&#128269; Active filters</span>"
			    & "<div class='fb-sep'></div>"
			    & "<div class='chip chip-" & _ChipCat  & "'><span class='chip-k'>Category</span><span class='chip-v'>" & _LblCat  & "</span>" & IF(_ChipCat  = "on","<span class='chip-dot'></span>","") & "</div>"
			    & "<div class='chip chip-" & _ChipBrch & "'><span class='chip-k'>Branch</span><span class='chip-v'>"   & _LblBrch & "</span>" & IF(_ChipBrch = "on","<span class='chip-dot'></span>","") & "</div>"
			    & "<div class='chip chip-" & _ChipPay  & "'><span class='chip-k'>Payment</span><span class='chip-v'>"  & _LblPay  & "</span>" & IF(_ChipPay  = "on","<span class='chip-dot'></span>","") & "</div>"
			    & "<span class='fb-count'>" & _fTR & " reviews</span>"
			    & "</div>"
			
			/* Top-5 items */
			VAR _hItems =
			    IF(_IC = 0, "<p class='nd'>No items in current context</p>",
			    CONCATENATEX(
			        TOPN(5, _IF, [@WR], DESC),
			        VAR _c  = IF([@WR] >= 4.2, "#10B981", IF([@WR] >= 3.5, "#F59E0B", "#EF4444"))
			        VAR _bg = IF([@WR] >= 4.2, "#ECFDF5", IF([@WR] >= 3.5, "#FFFBEB", "#FEF2F2"))
			        VAR _tx = IF([@WR] >= 4.2, "#065F46", IF([@WR] >= 3.5, "#B45309", "#991B1B"))
			        VAR _bw = FORMAT(ROUND([@WR] / 5 * 100, 0), "0")
			        VAR _wf = FORMAT([@WR], "0.00")
			        VAR _vf = FORMAT([@Rev], "#,##0")
			        VAR _qf = FORMAT([@SumQ], "#,##0")
			        RETURN
			        "<div class='ir'>"
			        & "<div class='il'><b class='in'>" & [item_name] & "</b>"
			        & "<span class='iv'>" & _qf & " sold · " & _vf & " EGP</span></div>"
			        & "<div class='ig'><div class='ibg'><div class='ib' style='width:" & _bw & "%;background:" & _c & "'></div></div>"
			        & "<span class='ibd' style='background:" & _bg & ";color:" & _tx & "'>" & _wf & "&#9733;</span></div></div>",
			        "", [@WR], DESC))
			
			/* Revenue matrix */
			VAR _hMtx =
			    IF(_IC = 0, "<p class='nd'>No data</p>",
			    CONCATENATEX(
			        TOPN(5, _IF, [@Rev], DESC),
			        VAR _bg = IF([@WR] >= 4.2, "#ECFDF5", IF([@WR] >= 3.5, "#FFFBEB", "#FEF2F2"))
			        VAR _tx = IF([@WR] >= 4.2, "#065F46", IF([@WR] >= 3.5, "#B45309", "#991B1B"))
			        VAR _lb = IF([@WR] >= 4.2, "&#9733; Star", IF([@WR] >= 3.5, "&#9675; Solid", "&#9888; Risk"))
			        VAR _wf = FORMAT([@WR], "0.00")
			        VAR _vf = FORMAT([@Rev], "#,##0")
			        VAR _rp = FORMAT(ROUND(DIVIDE([@Rev], _MaxRev, 0) * 100, 0), "0")
			        RETURN
			        "<div class='mr'>"
			        & "<div class='mi'><b class='mn'>" & [item_name] & "</b>"
			        & "<div class='mbt'><div style='width:" & _rp & "%;height:100%;background:#C7D2FE;border-radius:2px'></div></div>"
			        & "<span class='mv'>" & _vf & " EGP</span></div>"
			        & "<span class='mp' style='background:" & _bg & ";color:" & _tx & "'>" & _lb & "<br><b>" & _wf & "&#9733;</b></span></div>",
			        "", [@Rev], DESC))
			
			/* Trend */
			VAR _hTrend =
			    IF(COUNTROWS(_TD) = 0,
			       "<p class='nd'>No trend data — verify calendar · order_date relationship</p>",
			    CONCATENATEX(
			        _TD,
			        VAR _r  = [@R]
			        VAR _h  = FORMAT(ROUND(DIVIDE(_r - _TMin, _TRng, 0) * 68 + 18, 0), "0")
			        VAR _c  = IF(_r >= 4.2, "#10B981", IF(_r >= 3.5, "#F59E0B", "#EF4444"))
			        VAR _rf = FORMAT(_r, "0.00")
			        RETURN
			        "<div class='tc'><span class='tv' style='color:" & _c & "'>" & _rf & "</span>"
			        & "<div class='tbg'><div class='tb' style='height:" & _h & "%;background:" & _c & "'></div></div>"
			        & "<span class='tl'>" & [MonthYear] & "</span></div>",
			        "", [@S], ASC))
			
			/* ══ SECTION 9 — RETURN ═════════════════════════════════ */
			RETURN
			IF(NOT _HasData,
			"<div style='font-family:Segoe UI,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:220px;gap:10px;color:#64748B;text-align:center;padding:40px'><div style='font-size:42px'>&#128202;</div><div style='font-size:16px;font-weight:700;color:#0F172A;margin-top:4px'>No data in current filter context</div><div style='font-size:11px;margin-top:4px'>Use the slicers to adjust your selection</div></div>",
			
			"<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><style>
			*{margin:0;padding:0;box-sizing:border-box}
			:root{
			  --g:#10B981;--gbg:#ECFDF5;--gtx:#065F46;
			  --a:#F59E0B;--abg:#FFFBEB;--atx:#B45309;
			  --r:#EF4444;--rbg:#FEF2F2;--rtx:#991B1B;
			  --b:#3B82F6;--bbg:#EFF6FF;--btx:#1D4ED8;
			  --p:#8B5CF6;--pbg:#F5F3FF;--ptx:#5B21B6;
			  --ink:#0F172A;--sl:#334155;--mu:#64748B;
			  --bd:#E2E8F0;--sf:#F8FAFC;--cd:#FFFFFF;
			  --cy:#38BDF8;
			  --sh:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
			  --r16:16px;--r12:12px;--r8:8px;--r6:6px
			}
			body{font-family:'Segoe UI',system-ui,sans-serif;background:#F1F5F9;color:var(--ink);font-size:12px;padding:12px;line-height:1.5}
			.pg{display:flex;flex-direction:column;gap:12px}
			
			/* ── HEADER (no KPI strip) ────────── */
			.hdr{
			  background:var(--ink);border-radius:var(--r16);
			  padding:20px 24px;border-bottom:2px solid var(--cy)
			}
			.hdr-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
			.htit{font-size:18px;font-weight:700;color:#F8FAFC;letter-spacing:-.02em;line-height:1.2}
			.htit-icon{margin-right:6px}
			.hmeta{margin-top:8px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
			.hbadge{
			  display:inline-flex;align-items:center;gap:5px;
			  background:rgba(56,189,248,.15);border:1px solid rgba(56,189,248,.25);
			  border-radius:20px;padding:3px 11px;
			  font-size:9px;font-weight:600;color:var(--cy)
			}
			.hbadge-dot{width:5px;height:5px;border-radius:50%;background:var(--cy);flex-shrink:0}
			.hdate{font-size:9px;color:#64748B}
			
			/* ── FILTER STATUS BAR ────────────── */
			.fbar{
			  background:var(--cd);border:1px solid var(--bd);
			  border-radius:var(--r12);padding:8px 14px;
			  display:flex;align-items:center;gap:6px;
			  flex-wrap:wrap;box-shadow:var(--sh)
			}
			.fb-lbl{font-size:9px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;flex-shrink:0}
			.fb-sep{width:1px;height:16px;background:var(--bd);flex-shrink:0;margin:0 2px}
			.chip{
			  display:inline-flex;align-items:center;gap:4px;
			  padding:3px 10px;border-radius:20px;
			  border:1px solid var(--bd);background:var(--sf);
			  font-size:9px;color:var(--mu);white-space:nowrap
			}
			.chip-on{background:#EFF6FF;border-color:#BFDBFE;color:#1D4ED8;font-weight:600}
			.chip-k{font-size:8px;opacity:.7;margin-right:1px}
			.chip-on .chip-k{color:#60A5FA;opacity:1}
			.chip-v{max-width:100px;overflow:hidden;text-overflow:ellipsis}
			.chip-dot{width:5px;height:5px;border-radius:50%;background:#3B82F6;flex-shrink:0;margin-left:2px}
			.fb-count{margin-left:auto;font-size:9px;font-weight:700;color:var(--mu);white-space:nowrap;padding:3px 10px;background:var(--sf);border:1px solid var(--bd);border-radius:20px}
			
			/* ── SECTION LABEL ────────────────── */
			.sec{font-size:9px;font-weight:700;color:var(--mu);letter-spacing:.1em;text-transform:uppercase;display:flex;align-items:center;gap:8px}
			.sec::after{content:'';flex:1;height:1px;background:var(--bd)}
			
			/* ── KPI GRID ─────────────────────── */
			.kg{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
			.kc{background:var(--cd);border:1px solid var(--bd);border-radius:var(--r12);padding:18px 18px 15px;box-shadow:var(--sh);position:relative;overflow:hidden}
			.kc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--r12) var(--r12) 0 0}
			.kc.g::before{background:var(--g)}.kc.a::before{background:var(--a)}.kc.r::before{background:var(--r)}.kc.b::before{background:var(--b)}.kc.p::before{background:var(--p)}
			.ki{position:absolute;top:16px;right:16px;font-size:20px;opacity:.35}
			.kl{font-size:9px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}
			.kv{font-size:30px;font-weight:700;line-height:1;letter-spacing:-.03em;margin-bottom:5px}
			.kc.g .kv{color:var(--g)}.kc.a .kv{color:var(--a)}.kc.r .kv{color:var(--r)}.kc.b .kv{color:var(--b)}.kc.p .kv{color:var(--p)}
			.ks{font-size:10px;color:var(--mu);line-height:1.3}
			.kst{display:flex;gap:2px;margin-top:6px}
			.kst span{font-size:15px}
			
			/* ── CARD ─────────────────────────── */
			.cd{background:var(--cd);border:1px solid var(--bd);border-radius:var(--r12);padding:16px;box-shadow:var(--sh)}
			.ch2{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
			.ct{font-size:10px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em}
			.cs{font-size:9px;color:var(--mu);margin-top:2px}
			.bdg{font-size:8px;padding:3px 9px;border-radius:20px;font-weight:700;white-space:nowrap;flex-shrink:0}
			.b-b{background:var(--bbg);color:var(--btx)}.b-g{background:var(--gbg);color:var(--gtx)}
			.b-a{background:var(--abg);color:var(--atx)}.b-p{background:var(--pbg);color:var(--ptx)}
			
			/* ── LAYOUTS ──────────────────────── */
			.g3{display:grid;grid-template-columns:5fr 7fr 5fr;gap:10px}
			.g2{display:grid;grid-template-columns:7fr 5fr;gap:10px}
			.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
			
			/* ── DISTRIBUTION ─────────────────── */
			.dr{display:flex;align-items:center;gap:7px;margin-bottom:7px}
			.dr:last-child{margin-bottom:0}
			.dl{width:26px;font-size:10px;font-weight:700;color:var(--sl);flex-shrink:0}
			.ds{width:44px;flex-shrink:0;color:#F59E0B;font-size:10px;letter-spacing:-1.5px}
			.dt{flex:1;height:8px;background:#F1F5F9;border-radius:4px;overflow:hidden}
			.df{height:100%;border-radius:4px}
			.dn{width:38px;text-align:right;font-size:10px;font-weight:700;flex-shrink:0}
			.dp{width:26px;text-align:right;font-size:9px;color:var(--mu);flex-shrink:0}
			.sb{display:flex;height:5px;border-radius:3px;overflow:hidden;margin-top:10px}
			.lg{display:flex;gap:10px;margin-top:7px;font-size:9px;flex-wrap:wrap}
			.ld{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:3px;vertical-align:middle}
			
			/* ── TREND ────────────────────────── */
			.tch{display:flex;align-items:flex-end;gap:6px;height:90px;padding:0 2px}
			.tc{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:3px}
			.tbg{flex:1;width:100%;display:flex;align-items:flex-end}
			.tb{width:100%;border-radius:4px 4px 0 0;min-height:5px}
			.tv{font-size:8px;font-weight:700}
			.tl{font-size:7px;color:var(--mu);white-space:nowrap}
			.ta{display:flex;align-items:center;gap:6px;margin-top:9px;padding:6px 9px;background:var(--sf);border-radius:var(--r6);font-size:9px}
			.tn{font-size:9px;color:var(--mu);margin-top:8px;padding-top:8px;border-top:1px solid var(--bd)}
			
			/* ── CHANNEL ──────────────────────── */
			.cr{display:flex;align-items:center;gap:8px;margin-bottom:8px}
			.cr:last-child{margin-bottom:0}
			.cl{width:64px;font-size:10px;font-weight:600;color:var(--sl);flex-shrink:0}
			.ctr{flex:1;height:8px;background:#F1F5F9;border-radius:4px;overflow:hidden}
			.cf{height:100%;border-radius:4px}
			.cv{width:30px;text-align:right;font-size:11px;font-weight:700;flex-shrink:0}
			.dv{height:1px;background:var(--bd);margin:11px 0}
			.gl{font-size:9px;font-weight:700;color:var(--mu);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
			.gv{font-size:24px;font-weight:800;line-height:1}
			.gd{font-size:10px;color:var(--mu);margin-left:5px;vertical-align:middle}
			.gb{margin-top:9px;padding:7px 10px;border-radius:var(--r6);font-size:9px;font-weight:600;display:flex;align-items:center;gap:5px}
			
			/* ── ITEMS ────────────────────────── */
			.ir{display:flex;align-items:center;padding:8px 0;border-bottom:1px solid var(--sf)}
			.ir:last-child{border-bottom:none}
			.il{flex:1;min-width:0;margin-right:10px}
			.in{display:block;font-size:10px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
			.iv{display:block;font-size:9px;color:var(--mu);margin-top:1px}
			.ig{display:flex;align-items:center;gap:7px;flex-shrink:0}
			.ibg{width:68px;height:5px;background:#F1F5F9;border-radius:3px;overflow:hidden}
			.ib{height:100%;border-radius:3px}
			.ibd{padding:3px 8px;border-radius:var(--r6);font-size:10px;font-weight:700;white-space:nowrap}
			
			/* ── MATRIX ───────────────────────── */
			.mr{display:flex;align-items:center;padding:8px 10px;border-radius:var(--r6);background:var(--sf);gap:8px;margin-bottom:4px}
			.mr:last-child{margin-bottom:0}
			.mi{flex:1;min-width:0}
			.mn{display:block;font-size:9px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:3px}
			.mbt{height:3px;background:var(--bd);border-radius:2px;overflow:hidden;margin-bottom:3px}
			.mv{display:block;font-size:8px;color:var(--mu)}
			.mp{display:block;padding:5px 9px;border-radius:var(--r6);font-size:8px;font-weight:700;text-align:center;min-width:54px;line-height:1.5;flex-shrink:0}
			
			/* ── INSIGHT CARDS ────────────────── */
			.ic{border-radius:var(--r12);padding:14px;border:1px solid transparent;position:relative;overflow:hidden}
			.ic::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
			.ic-r{background:var(--rbg);border-color:#FECACA}.ic-r::before{background:var(--r)}
			.ic-g{background:var(--gbg);border-color:#A7F3D0}.ic-g::before{background:var(--g)}
			.ic-a{background:var(--abg);border-color:#FDE68A}.ic-a::before{background:var(--a)}
			.ic-b{background:var(--bbg);border-color:#BFDBFE}.ic-b::before{background:var(--b)}
			.itg{font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px;display:flex;align-items:center;gap:4px}
			.ic-r .itg{color:var(--rtx)}.ic-g .itg{color:var(--gtx)}.ic-a .itg{color:var(--atx)}.ic-b .itg{color:var(--btx)}
			.itd{width:5px;height:5px;border-radius:50%;flex-shrink:0}
			.in2{font-size:14px;font-weight:700;color:var(--ink);line-height:1.2;margin-bottom:3px}
			.im2{font-size:9px;color:var(--mu);margin-bottom:6px;line-height:1.4}
			.ib2{font-size:9px;line-height:1.6;color:var(--sl)}
			
			/* ── REC BOX ──────────────────────── */
			.rb{background:var(--ink);border-radius:var(--r12);padding:14px 18px;display:flex;gap:13px;align-items:flex-start}
			.ri{font-size:20px;flex-shrink:0;margin-top:1px}
			.rt{font-size:9px;font-weight:700;color:var(--cy);text-transform:uppercase;letter-spacing:.09em;margin-bottom:5px}
			.rbd{font-size:10px;color:#CBD5E1;line-height:1.7}
			
			/* ── FOOTER ───────────────────────── */
			.ft{display:flex;gap:10px;font-size:9px;color:var(--mu);padding:9px 14px;background:var(--cd);border-radius:var(--r8);border:1px solid var(--bd);align-items:center;flex-wrap:wrap}
			.fl{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:3px;vertical-align:middle}
			.nd{text-align:center;color:var(--mu);font-size:10px;padding:20px;border:1px dashed var(--bd);border-radius:var(--r8);font-style:italic}
			</style></head><body><div class='pg'>
			
			<!-- HEADER — clean, no KPI strip -->
			<div class='hdr'>
			  <div class='hdr-top'>
			    <div>
			      <div class='htit'><span class='htit-icon'>&#11088;</span>Customer Reviews &amp; Satisfaction</div>
			    </div>
			  </div>
			  <div class='hmeta'>
			    <div class='hbadge'><span class='hbadge-dot'></span>Live dashboard</div>
			    <span class='hdate'>Responds to all slicers · " & _fTR & " reviews in current context</span>
			  </div>
			</div>
			
			<!-- FILTER STATUS BAR -->
			" & _hFBar & "
			
			<!-- KPI CARDS — single source of truth -->
			<div class='sec'>Performance Overview</div>
			<div class='kg'>
			  <div class='kc " & _kAvg & "'>
			    <div class='ki'>&#11088;</div>
			    <div class='kl'>Avg Rating</div>
			    <div class='kv'>" & _fAvg & "</div>
			    <div class='kst'>
			      <span style='color:" & _S1 & "'>&#9733;</span>
			      <span style='color:" & _S2 & "'>&#9733;</span>
			      <span style='color:" & _S3 & "'>&#9733;</span>
			      <span style='color:" & _S4 & "'>&#9733;</span>
			      <span style='color:" & _S5 & "'>&#9733;</span>
			    </div>
			  </div>
			  <div class='kc b'>
			    <div class='ki'>&#128203;</div>
			    <div class='kl'>Total Reviews</div>
			    <div class='kv'>" & _fTR & "</div>
			    <div class='ks'>Current context</div>
			  </div>
			  <div class='kc " & _kPos & "'>
			    <div class='ki'>&#128077;</div>
			    <div class='kl'>Positive %</div>
			    <div class='kv'>" & _fPos & "%</div>
			    <div class='ks'>Rating ≥ 4 stars</div>
			  </div>
			  <div class='kc " & _kNeg & "'>
			    <div class='ki'>&#128078;</div>
			    <div class='kl'>Negative %</div>
			    <div class='kv'>" & _fNeg & "%</div>
			    <div class='ks'>Rating ≤ 2 stars</div>
			  </div>
			  <div class='kc " & _kCSI & "'>
			    <div class='ki'>&#127942;</div>
			    <div class='kl'>CSI Score</div>
			    <div class='kv'>" & _fCSI & "</div>
			    <div class='ks'>Target: 85.0</div>
			  </div>
			</div>
			
			<!-- SECTION 1: DISTRIBUTION + TREND + CHANNEL -->
			<div class='sec'>Rating Distribution &amp; Trend</div>
			<div class='g3'>
			  <div class='cd'>
			    <div class='ch2'><div><div class='ct'>Distribution</div><div class='cs'>Count per star level</div></div><span class='bdg b-b'>Chart</span></div>
			    <div class='dr'><div class='dl'>5&#9733;</div><div class='ds'>&#9733;&#9733;&#9733;&#9733;&#9733;</div><div class='dt'><div class='df' style='width:" & _fW5 & "%;background:#10B981'></div></div><div class='dn' style='color:#10B981'>" & _C5 & "</div><div class='dp'>" & _fW5 & "%</div></div>
			    <div class='dr'><div class='dl'>4&#9733;</div><div class='ds'>&#9733;&#9733;&#9733;&#9733;</div><div class='dt'><div class='df' style='width:" & _fW4 & "%;background:#34D399'></div></div><div class='dn' style='color:#059669'>" & _C4 & "</div><div class='dp'>" & _fW4 & "%</div></div>
			    <div class='dr'><div class='dl'>3&#9733;</div><div class='ds'>&#9733;&#9733;&#9733;</div><div class='dt'><div class='df' style='width:" & _fW3 & "%;background:#F59E0B'></div></div><div class='dn' style='color:#D97706'>" & _C3 & "</div><div class='dp'>" & _fW3 & "%</div></div>
			    <div class='dr'><div class='dl'>2&#9733;</div><div class='ds'>&#9733;&#9733;</div><div class='dt'><div class='df' style='width:" & _fW2 & "%;background:#F87171'></div></div><div class='dn' style='color:#DC2626'>" & _C2 & "</div><div class='dp'>" & _fW2 & "%</div></div>
			    <div class='dr'><div class='dl'>1&#9733;</div><div class='ds'>&#9733;</div><div class='dt'><div class='df' style='width:" & _fW1 & "%;background:#EF4444'></div></div><div class='dn' style='color:#DC2626'>" & _C1 & "</div><div class='dp'>" & _fW1 & "%</div></div>
			    <div class='sb'><div style='width:" & _fPosB & "%;background:#10B981;height:100%'></div><div style='width:" & _fNeuB & "%;background:#E2E8F0;height:100%'></div><div style='width:" & _fNegB & "%;background:#EF4444;height:100%'></div></div>
			    <div class='lg'>
			      <span><span class='ld' style='background:#10B981'></span><span style='color:#065F46;font-weight:600'>Positive " & _fPos & "%</span></span>
			      <span><span class='ld' style='background:#9CA3AF'></span><span style='color:var(--mu)'>Neutral " & _fNeu & "%</span></span>
			      <span><span class='ld' style='background:#EF4444'></span><span style='color:#991B1B;font-weight:600'>Negative " & _fNeg & "%</span></span>
			    </div>
			  </div>
			
			  <div class='cd'>
			    <div class='ch2'><div><div class='ct'>Rating Trend</div><div class='cs'>Last 6 months · monthly average</div></div><span class='bdg b-g'>Trend</span></div>
			    <div class='tch'>" & _hTrend & "</div>
			    <div class='ta'>
			      <span style='font-size:15px;color:" & _TArrC & ";font-weight:800'>" & _TArr & "</span>
			      <span style='font-weight:700;color:" & _TArrC & "'>" & _TDeltaFmt & " pts</span>
			      <span style='color:var(--mu)'>vs prior month</span>
			    </div>
			    <div class='tn'>&#9632; ≥4.2 Excellent &nbsp;&#9632; ≥3.5 Good &nbsp;&#9632; &lt;3.5 At risk</div>
			  </div>
			
			  <div class='cd'>
			    <div class='ch2'><div><div class='ct'>By Order Type</div><div class='cs'>Avg rating per channel</div></div><span class='bdg b-p'>Channel</span></div>
			    <div class='cr'><div class='cl'>Dine-in</div><div class='ctr'><div class='cf' style='width:" & _fDineW & "%;background:" & _cDine & "'></div></div><div class='cv' style='color:" & _cDine & "'>" & _fDine & "</div></div>
			    <div class='cr'><div class='cl'>Takeaway</div><div class='ctr'><div class='cf' style='width:" & _fTakeW & "%;background:" & _cTake & "'></div></div><div class='cv' style='color:" & _cTake & "'>" & _fTake & "</div></div>
			    <div class='cr'><div class='cl'>Delivery</div><div class='ctr'><div class='cf' style='width:" & _fDelW & "%;background:" & _cDel & "'></div></div><div class='cv' style='color:" & _cDel & "'>" & _fDel & "</div></div>
			    <div class='dv'></div>
			    <div class='gl'>Delivery gap vs dine-in</div>
			    <div><span class='gv' style='color:" & _cGap & "'>" & _fGap & "</span><span class='gd'>pts " & _gDir & " dine-in</span></div>
			    <div class='gb' style='background:" & _gBg & ";color:" & _gTx & "'>" & _gMsg & "</div>
			  </div>
			</div>
			
			<!-- SECTION 2: ITEMS + MATRIX -->
			<div class='sec'>Top Items &amp; Revenue Matrix</div>
			<div class='g2'>
			  <div class='cd'>
			    <div class='ch2'><div><div class='ct'>Top 5 Items — Weighted Rating</div><div class='cs'>Qty-weighted · ranked by satisfaction</div></div><span class='bdg b-g'>Ranked</span></div>
			    " & _hItems & "
			  </div>
			  <div class='cd'>
			    <div class='ch2'><div><div class='ct'>Revenue vs Rating</div><div class='cs'>Top 5 by revenue · satisfaction tier</div></div><span class='bdg b-a'>Matrix</span></div>
			    " & _hMtx & "
			  </div>
			</div>
			
			<!-- SECTION 3: INSIGHTS -->
			<div class='sec'>Actionable Insights</div>
			<div class='g4'>
			  <div class='ic ic-r'>
			    <div class='itg'><span class='itd' style='background:var(--r)'></span>Risk Alert</div>
			    <div class='in2'>" & _RiskNm & "</div>
			    <div class='im2'>Top-3 revenue · " & _fRR & "&#9733; · " & _fRRv & " EGP</div>
			    <div class='ib2'>Highest-earning with weakest satisfaction. Quality gap at maximum scale. Immediate audit required.</div>
			  </div>
			  <div class='ic ic-g'>
			    <div class='itg'><span class='itd' style='background:var(--g)'></span>Star Performer</div>
			    <div class='in2'>" & _StarNm & "</div>
			    <div class='im2'>Top-5 revenue · " & _fSR & "&#9733; · " & _fSRv & " EGP</div>
			    <div class='ib2'>High volume AND high satisfaction. Quality benchmark. Feature in all promotions.</div>
			  </div>
			  <div class='ic ic-a'>
			    <div class='itg'><span class='itd' style='background:var(--a)'></span>Growth Opportunity</div>
			    <div class='in2'>" & _OppNm & "</div>
			    <div class='im2'>High qty · " & _fOR & "&#9733; · " & FORMAT(_OppQ, "#,##0") & " units</div>
			    <div class='ib2'>Above-avg volume, mid satisfaction. A 0.3&#9733; lift here gives the highest CSI gain per effort.</div>
			  </div>
			  <div class='ic ic-b'>
			    <div class='itg'><span class='itd' style='background:var(--b)'></span>Delivery Insight</div>
			    <div class='in2'>" & _fGap & " pt Gap</div>
			    <div class='im2'>Dine-in " & _fDine & "&#9733; &nbsp;&#183;&nbsp; Delivery " & _fDel & "&#9733;</div>
			    <div class='ib2'>" & _gMsg & ". " & IF(_GapA > 0.5, "Deploy exit survey — focus on packaging and ETA.", "Maintain standards and monitor monthly.") & "</div>
			  </div>
			</div>
			
			<!-- RECOMMENDATION -->
			<div class='rb'>
			  <div class='ri'>&#128204;</div>
			  <div>
			    <div class='rt'>Strategic Recommendation</div>
			    <div class='rbd'>" & _rec & "</div>
			  </div>
			</div>
			
			<!-- FOOTER -->
			<div class='ft'>
			  <span style='font-weight:700;color:var(--ink)'>Scale:</span>
			  <span><span class='fl' style='background:#10B981'></span>≥4.2 Excellent</span>
			  <span><span class='fl' style='background:#F59E0B'></span>3.5–4.2 Good</span>
			  <span><span class='fl' style='background:#EF4444'></span>&lt;3.5 At risk</span>
			  <span style='margin-left:auto;font-weight:600;color:var(--ink)'>CSI " & _fCSI & "/100 · Wtd " & _fWtd & " · " & _fTR & " reviews</span>
			</div>
			
			</div></body></html>"
			)
		lineageTag: d92f6e9d-8f84-4249-a6f3-8ab054b4f072

	measure Measure
		lineageTag: 6afa3aa2-a4aa-43df-9123-a8557d321bf4

	measure 2ReviewsDashboard
		lineageTag: bc8ec5b2-cc7f-4224-a284-240dec10bbbc

	measure 'Average review per item' =
			
			CALCULATE (
			    AVERAGE ( final_table_clean[rating] ),
			    ALLEXCEPT ( final_table_clean, final_table_clean[item_name] )
			)
		lineageTag: 89ab7351-d30b-4c5d-913a-b75fb3003952

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AI_Insight_Summary =
			
			
			VAR CurrentSales =
			    [Total Sales]
			
			VAR PreviousSales =
			    CALCULATE(
			        [Total Sales],
			        DATEADD(calendar[Date], -1, YEAR)
			    )
			
			VAR GrowthValue =
			    DIVIDE(
			        CurrentSales - PreviousSales,
			        PreviousSales
			    )
			
			VAR RevenueGrowth =
			    FORMAT(GrowthValue, "+0.0%;-0.0%")
			
			VAR CSI =
			    FORMAT([CSIScore], "0.0")
			
			VAR AvgRating =
			    FORMAT([Average review], "0.00")
			
			VAR TotalSales =
			    FORMAT([Total Sales] / 1000000000, "0.00") & "B"
			
			VAR Orders =
			    FORMAT([Orders] / 1000000, "0.0") & "M"
			
			VAR Customers =
			    FORMAT([Customer] / 1000, "0") & "K"
			
			VAR AOVValue =
			    FORMAT([AOV], "0.00")
			
			
			VAR TopRow =
			    TOPN(
			        1,
			        FILTER(
			            mba_rules,
			            NOT ISBLANK(mba_rules[Product_A]) &&
			            NOT ISBLANK(mba_rules[Product_B]) &&
			            mba_rules[lift] > 1
			        ),
			        mba_rules[lift], DESC,
			        mba_rules[confidence], DESC,
			        mba_rules[support], DESC
			    )
			
			VAR TopProductA =
			    MAXX(
			        TopRow,
			        mba_rules[Product_A]
			    )
			
			VAR TopProductB =
			    MAXX(
			        TopRow,
			        mba_rules[Product_B]
			    )
			
			VAR TopPair =
			    TopProductA & " + " & TopProductB
			
			VAR BestBranch =
			    TOPN(
			        1,
			        SUMMARIZE(
			            final_table_clean,
			            final_table_clean[branch],
			            "SalesValue", [Total Sales]
			        ),
			        [SalesValue],
			        DESC
			    )
			
			VAR BranchName =
			    CONCATENATEX(
			        BestBranch,
			        final_table_clean[branch],
			        ", "
			    )
			
			RETURN
			
			"
			<div style='
			width:100%;
			padding:18px;
			border-radius:22px;
			
			background:rgba(10,25,47,.45);
			
			backdrop-filter:blur(6px);
			-webkit-backdrop-filter:blur(6px);
			
			border:1px solid rgba(255,255,255,.08);
			
			box-shadow:
			0 4px 24px rgba(0,0,0,.28),
			0 0 10px rgba(96,165,250,.08);
			
			font-family:Segoe UI;
			color:white;
			overflow:hidden;
			'>
			
			<!-- HEADER -->
			
			<div style='
			display:flex;
			justify-content:space-between;
			align-items:center;
			margin-bottom:18px;
			'>
			
			<div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			letter-spacing:.3px;
			color:#F8FAFC;
			'>
			 Business Insights
			</div>
			
			<div style='
			font-size:11px;
			color:#94A3B8;
			margin-top:2px;
			'>
			Live AI-powered restaurant intelligence
			</div>
			
			</div>
			
			<div style='
			font-size:11px;
			padding:6px 10px;
			border-radius:30px;
			background:rgba(59,130,246,.15);
			color:#93C5FD;
			border:1px solid rgba(147,197,253,.15);
			'>
			LIVE
			</div>
			
			</div>
			
			<!-- KPI STRIP -->
			
			<div style='
			display:grid;
			grid-template-columns:repeat(2,1fr);
			gap:10px;
			margin-bottom:18px;
			'>
			
			<div style='
			background:rgba(255,255,255,.05);
			padding:12px;
			border-radius:14px;
			'>
			
			<div style='
			font-size:10px;
			color:#94A3B8;
			margin-bottom:4px;
			'>
			TOTAL SALES
			</div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			color:#60A5FA;
			'>
			" & TotalSales & "
			</div>
			
			</div>
			
			<div style='
			background:rgba(255,255,255,.05);
			padding:12px;
			border-radius:14px;
			'>
			
			<div style='
			font-size:10px;
			color:#94A3B8;
			margin-bottom:4px;
			'>
			ORDERS
			</div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			color:#F59E0B;
			'>
			" & Orders & "
			</div>
			
			</div>
			
			<div style='
			background:rgba(255,255,255,.05);
			padding:12px;
			border-radius:14px;
			'>
			
			<div style='
			font-size:10px;
			color:#94A3B8;
			margin-bottom:4px;
			'>
			CUSTOMERS
			</div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			color:#10B981;
			'>
			" & Customers & "
			</div>
			
			</div>
			
			<div style='
			background:rgba(255,255,255,.05);
			padding:12px;
			border-radius:14px;
			'>
			
			<div style='
			font-size:10px;
			color:#94A3B8;
			margin-bottom:4px;
			'>
			AVG RATING
			</div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			color:#FACC15;
			'>
			⭐ " & AvgRating & "
			</div>
			
			</div>
			
			</div>
			
			<!-- INSIGHTS -->
			
			<div style='
			display:flex;
			flex-direction:column;
			gap:12px;
			'>
			
			<div style='
			padding:12px;
			border-radius:14px;
			background:rgba(16,185,129,.08);
			border-left:4px solid #10B981;
			'>
			
			<div style='
			font-size:13px;
			font-weight:700;
			color:#10B981;
			margin-bottom:4px;
			'>
			✔ Revenue Growth
			</div>
			
			<div style='
			font-size:13px;
			color:#E2E8F0;
			'>
			Revenue increased by
			<b>" & RevenueGrowth & "</b>
			compared to previous period.
			</div>
			
			</div>
			
			<div style='
			padding:12px;
			border-radius:14px;
			background:rgba(245,158,11,.08);
			border-left:4px solid #F59E0B;
			'>
			
			<div style='
			font-size:13px;
			font-weight:700;
			color:#F59E0B;
			margin-bottom:4px;
			'>
			✔ Customer Satisfaction
			</div>
			
			<div style='
			font-size:13px;
			color:#E2E8F0;
			'>
			Current CSI reached
			<b>" & CSI & "</b>
			with strong positive feedback trends.
			</div>
			
			</div>
			
			<div style='
			padding:12px;
			border-radius:14px;
			background:rgba(96,165,250,.08);
			border-left:4px solid #60A5FA;
			'>
			
			<div style='
			font-size:13px;
			font-weight:700;
			color:#60A5FA;
			margin-bottom:4px;
			'>
			✔ Strongest Product Pair
			</div>
			
			<div style='
			font-size:13px;
			font-weight:600;
			color:#DBEAFE;
			'>
			" & TopPair & "
			</div>
			
			</div>
			
			<div style='
			padding:12px;
			border-radius:14px;
			background:rgba(52,211,153,.08);
			border-left:4px solid #34D399;
			'>
			
			<div style='
			font-size:13px;
			font-weight:700;
			color:#34D399;
			margin-bottom:4px;
			'>
			✔ Best Performing Branch
			</div>
			
			<div style='
			font-size:13px;
			font-weight:600;
			color:#D1FAE5;
			'>
			" & BranchName & "
			</div>
			
			</div>
			
			</div>
			
			</div>
			"
		lineageTag: c64b485b-ed1b-4628-8aec-27940c770034

	measure AI_Recommendations =
			
			
			VAR CSI =
			    [CSIScore]
			
			VAR PositiveRate =
			    [PositivePercent]
			
			VAR DeliveryGap =
			    [DeliveryAvg] - [DineInAvg]
			
			VAR WorstBranch =
			    TOPN(
			        1,
			        SUMMARIZE(
			            final_table_clean,
			            final_table_clean[branch],
			            "BranchRating", [Average review]
			        ),
			        [BranchRating],
			        ASC
			    )
			
			VAR WorstBranchName =
			    CONCATENATEX(
			        WorstBranch,
			        final_table_clean[branch],
			        ", "
			    )
			
			VAR LowProduct =
			    TOPN(
			        1,
			        SUMMARIZE(
			            final_table_clean,
			            final_table_clean[item_name],
			            "ItemRating", [Average review]
			        ),
			        [ItemRating],
			        ASC
			    )
			
			VAR LowProductName =
			    CONCATENATEX(
			        LowProduct,
			        final_table_clean[item_name],
			        ", "
			    )
			
			RETURN
			
			"
			<div style='
			width:100%;
			padding:18px;
			border-radius:22px;
			
			background:rgba(10,25,47,.45);
			
			backdrop-filter:blur(6px);
			-webkit-backdrop-filter:blur(6px);
			
			border:1px solid rgba(255,255,255,.08);
			
			box-shadow:
			0 4px 24px rgba(0,0,0,.28),
			0 0 10px rgba(96,165,250,.08);
			
			font-family:Segoe UI;
			color:white;
			overflow:hidden;
			'>
			
			<!-- HEADER -->
			
			<div style='
			display:flex;
			justify-content:space-between;
			align-items:center;
			margin-bottom:18px;
			'>
			
			<div>
			
			<div style='
			font-size:22px;
			font-weight:700;
			letter-spacing:.3px;
			color:#F8FAFC;
			'>
			 Recommendations
			</div>
			
			<div style='
			font-size:11px;
			color:#94A3B8;
			margin-top:2px;
			'>
			Smart operational recommendations
			</div>
			
			</div>
			
			<div style='
			font-size:11px;
			padding:6px 10px;
			border-radius:30px;
			background:rgba(7,15,30,.62);
			color:#C4B5FD;
			border:1px solid rgba(196,181,253,.15);
			'>
			AI ENGINE
			</div>
			
			</div>
			
			<!-- RECOMMENDATIONS -->
			
			<div style='
			display:flex;
			flex-direction:column;
			gap:14px;
			'>
			
			<div style='
			background:rgba(16,185,129,.08);
			padding:14px;
			border-radius:14px;
			border-left:4px solid #10B981;
			transition:all .25s ease;
			'>
			
			<div style='
			font-size:14px;
			font-weight:700;
			color:#10B981;
			margin-bottom:6px;
			'>
			✔ Customer Experience
			</div>
			
			<div style='
			font-size:12px;
			line-height:1.7;
			color:#E2E8F0;
			'>
			Maintain customer satisfaction above
			<b>" & FORMAT(CSI,"0.0") & "</b>
			through service consistency and faster response handling.
			</div>
			
			</div>
			
			<div style='
			background:rgba(245,158,11,.08);
			padding:14px;
			border-radius:14px;
			border-left:4px solid #F59E0B;
			'>
			
			<div style='
			font-size:14px;
			font-weight:700;
			color:#F59E0B;
			margin-bottom:6px;
			'>
			⚠ Delivery Optimization
			</div>
			
			<div style='
			font-size:12px;
			line-height:1.7;
			color:#E2E8F0;
			'>
			Delivery gap is
			<b>" & FORMAT(DeliveryGap,"0.00") & "</b>.
			Improve delivery timing and packaging quality.
			</div>
			
			</div>
			
			<div style='
			background:rgba(239,68,68,.08);
			padding:14px;
			border-radius:14px;
			border-left:4px solid #EF4444;
			'>
			
			<div style='
			font-size:14px;
			font-weight:700;
			color:#EF4444;
			margin-bottom:6px;
			'>
			✖ Branch Attention Needed
			</div>
			
			<div style='
			font-size:12px;
			line-height:1.7;
			color:#E2E8F0;
			'>
			Immediate operational review required for branch:
			<b>" & WorstBranchName & "</b>
			due to low satisfaction performance.
			</div>
			
			</div>
			
			<div style='
			background:rgba(96,165,250,.08);
			padding:14px;
			border-radius:14px;
			border-left:4px solid #60A5FA;
			'>
			
			<div style='
			font-size:14px;
			font-weight:700;
			color:#60A5FA;
			margin-bottom:6px;
			'>
			★ Menu Improvement
			</div>
			
			<div style='
			font-size:12px;
			line-height:1.7;
			color:#E2E8F0;
			'>
			Review customer feedback for:
			<b>" & LowProductName & "</b>
			to improve product quality and overall experience.
			</div>
			
			</div>
			
			<div style='
			background:rgba(139,92,246,.08);
			padding:14px;
			border-radius:14px;
			border-left:4px solid #8B5CF6;
			'>
			
			<div style='
			font-size:14px;
			font-weight:700;
			color:#8B5CF6;
			margin-bottom:6px;
			'>
			📈 Growth Opportunity
			</div>
			
			<div style='
			font-size:12px;
			line-height:1.7;
			color:#E2E8F0;
			'>
			Positive review rate reached
			<b>" & FORMAT(PositiveRate,"0.0%") & "</b>.
			Promote high-rated products through marketing campaigns.
			</div>
			
			</div>
			
			</div>
			
			</div>
			"
